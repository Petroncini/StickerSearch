{
  "manifest_version": 3,
  "name": "WhatsApp Sticker Search",
  "version": "0.1.0",
  "description": "Semantic search for the WhatsApp Web sticker panel. Runs CLIP locally; nothing leaves your machine except the one-time model download.",
  "browser_specific_settings": {
    "gecko": {
      "id": "wa-sticker-search@caio.local",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "background": { "page": "background.html" },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Sticker Search",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "host_permissions": ["https://huggingface.co/*", "https://*.hf.co/*", "https://*.huggingface.co/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
